{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aurionstack.dev" }],
      "destination": "https://www.aurionstack.dev/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-post",
      "schedule": "0 9 * * 1"
    }
  ]
}
